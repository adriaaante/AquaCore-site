# Apache-настройки для хостинга reg.ru (попадает в корень сайта при сборке).

AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

# Сжатие текстовых ресурсов
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Кэширование статики (хэшированные ассеты Next.js можно кэшировать надолго)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType video/mp4 "access plus 7 days"
  ExpiresByType video/webm "access plus 7 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
